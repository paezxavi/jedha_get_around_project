# Copy to .env and fill in your own credentials for the shared MLflow stack — the same
# tracking server, Neon backend store and R2 artifact store as the tomato-ripeness project.
#
# THIS file is committed and carries key names only. The filled .env never is (.gitignore
# excludes it), and on the Spaces these values come from Hugging Face secrets rather than
# from a file baked into a layer.
#
# The last two are not secrets: they name the model rather than granting access to it, and
# they are set as Space *variables*. Everything above them is a Space *secret*.

# --- MLflow client ---
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_TOKEN=
MLFLOW_S3_ENDPOINT_URL=

# --- R2, reached through MLflow's S3 artifact repo ---
# The server runs with --no-serve-artifacts, so every client uploads and downloads the model
# bytes itself, straight from R2 (hence boto3 in the requirements).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

# --- This project's model in the shared registry ---
MLFLOW_REGISTERED_MODEL_NAME=getaround-pricing-model
MLFLOW_MODEL_ALIAS=champion
