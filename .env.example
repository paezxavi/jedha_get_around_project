# Copy to .env and fill in with your own credentials — .env is git-ignored, this file is not.
#   cp .env.example .env
#
# Getaround has its own MLflow stack: its own tracking server Space, its own Neon database
# and its own R2 bucket. Nothing here is shared with another project, so revoking any of
# these credentials affects this project and no other.
#
# On the Spaces these values come from Hugging Face secrets, never from a file baked into a
# layer. Which Space needs which variable is listed at the bottom.

# --- MLflow tracking server (mlflow_server/) ---
# Neon console > your project > Connect > use the DIRECT hostname (without "-pooler")
BACKEND_STORE_URI=postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require
# The R2 bucket that holds the model bytes
ARTIFACT_ROOT=s3://<bucket>

# --- MLflow clients (training/train.py, api/app.py) ---
# Execution URL of the tracking-server Space
MLFLOW_TRACKING_URI=https://<user>-getaround-mlflow.hf.space
# The Space is private, so every request carries a bearer token: a Hugging Face token with
# read access to it. This is what makes the Space's privacy the access control.
MLFLOW_TRACKING_TOKEN=

# --- Cloudflare R2, reached through MLflow's S3 artifact repo ---
# Cloudflare dashboard > R2 > Manage API tokens > Create token (Object Read & Write)
# Needed by the server AND by both clients: the server runs with --no-serve-artifacts, so
# every client uploads and downloads the model bytes itself, straight from R2.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Account-specific endpoint, shown on the R2 overview page
MLFLOW_S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# R2 ignores the region but boto3 refuses to sign a request without one
AWS_DEFAULT_REGION=auto

# --- This project's model in its registry ---
# Not secrets: they name the model rather than granting access to it, and are set as Space
# *variables* rather than Space *secrets*.
MLFLOW_REGISTERED_MODEL_NAME=getaround-pricing-model
MLFLOW_MODEL_ALIAS=champion

# Which Space needs what
#   getaround-mlflow (private)  BACKEND_STORE_URI, ARTIFACT_ROOT, AWS_*, MLFLOW_S3_ENDPOINT_URL
#   getaround-pricing-api       MLFLOW_TRACKING_URI, MLFLOW_TRACKING_TOKEN, AWS_*,
#                               MLFLOW_S3_ENDPOINT_URL, and the two MLFLOW_*_NAME/ALIAS variables
#   getaround-delay-dashboard   nothing — it reads a file shipped in its own image
